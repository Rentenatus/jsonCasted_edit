<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The TestNG suite of jsonCasted_edit (the run recipe of the repository).

  The tests resolve their asset files relative to the working directory, so run it from
  THIS directory (test_assets):

      cd test_assets
      java -cp <test classes>;<main classes>;<jsonCasted classes>;<testng jars> org.testng.TestNG jce_testng.xml

  The asset tree lives here: assets/config. TypeParserServiceNGTest needs it - from the
  repository root the class would fail its configuration silently and skip all tests.
-->
